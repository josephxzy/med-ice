{
  "_description": "词条过滤规则。每条规则顺序执行：先检查长度，再排除 stop_words，最后按 include/exclude 正则匹配。",

  "length": {
    "min": 2,
    "max": 15
  },

  "min_freq": 1,

  "stop_words": [
    "是在", "各种", "分为", "包括", "称为", "相关", "以及", "两者",
    "位于", "具有", "可以", "参与", "形成", "经过", "主要",
    "一个", "这个", "它的", "它们", "一些", "这些", "一般",
    "所谓", "发生", "特别", "出现", "进行", "产生", "引起",
    "由于", "所以", "因此", "另外", "并且", "还有",
    "或", "和", "的", "是", "在", "有", "为", "与", "及", "等",
    "之间", "分布", "构成", "发出", "结构", "系统", "部分",
    "两侧", "作用", "功能", "器官", "通过", "不同",
    "结合", "保护", "之下", "之中", "之上", "之一",
    "利比里亚"
  ],

  "require_cjk": true,

  "exclude": [
    {"pattern": "^[0-9]+$", "description": "纯数字"},
    {"pattern": "^[a-zA-Z]+$", "description": "纯英文单词"},
    {"pattern": "^[0-9a-zA-Z]+$", "description": "纯英文数字组合"},
    {"pattern": "^\\W+$", "description": "纯符号或空白"},
    {"pattern": "^[A-Z0-9]+[\\u4e00-\\u9fff]", "description": "英文/数字前缀+中文（SARS病毒、A型、71型）"},
    {"pattern": "^[零一二三四五六七八九十百千万亿两几数多]+$", "description": "纯中文数字"},
    {"pattern": "^第[0-9零一二三四五六七八九十百千]+[天周月年章节条]$", "description": "第X天/周/章等序数"},
    {"pattern": "^第[0-9零一二三四五六七八九十百千]+$", "description": "纯序数（第十、第一）"},
    {"pattern": "^[零一二三四五六七八九十百千万亿两几数多]+[个种次回型]$", "description": "中文数字+量词"},
    {"pattern": "^[0-9]+[个种次回型]$", "description": "阿拉伯数字+量词（18种、71型）"},
    {"pattern": "^[0-9]+世纪$", "description": "N世纪"},
    {"pattern": "^[0-9]+[年月]$", "description": "N年/N月"},
    {"pattern": ".*[～~].*", "description": "含范围符号～~"},
    {"pattern": "^为[\\u4e00-\\u9fff]{2,}$", "description": "为+名词/动词短语（为病进、为本期）"},
    {"pattern": "^[也所][\\u4e00-\\u9fff]+$", "description": "也/所+内容（也可导致、所引起）"}
  ],

  "include": [
    {"pattern": ".*", "description": "默认：接受所有通过排除规则的词"}
  ]
}
